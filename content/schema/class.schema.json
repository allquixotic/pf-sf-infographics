{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable identifier (lowercase, digits, hyphens)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "core",
        "expansion",
        "playtest",
        "legacy"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2})?$",
          "description": "Release date as YYYY or YYYY-MM."
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title",
        "date"
      ]
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Id of one of the game groups."
    },
    "keyAttributes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Stable identifier (lowercase, digits, hyphens)."
      },
      "description": "Attribute ids; more than one means \"choose one\"."
    },
    "traditions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Stable identifier (lowercase, digits, hyphens)."
      },
      "description": "Tradition ids the class can cast from; empty for non-casters."
    },
    "traditionsChosen": {
      "default": false,
      "description": "True when the tradition is picked by subclass (all listed ones are possible).",
      "type": "boolean"
    },
    "casting": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable identifier (lowercase, digits, hyphens)."
        },
        {
          "type": "null"
        }
      ],
      "description": "Casting type id, or null."
    },
    "hp": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "ratings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Stable identifier (lowercase, digits, hyphens)."
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 5,
            "multipleOf": 0.5,
            "description": "0 to 5 in steps of 0.5; half values draw a half square."
          },
          {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "multipleOf": 0.5,
                "description": "0 to 5 in steps of 0.5; half values draw a half square."
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "multipleOf": 0.5,
                "description": "0 to 5 in steps of 0.5; half values draw a half square."
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "description": "A range drawn with hatched squares: a fundamental choice moves the class between the two."
          }
        ]
      }
    },
    "features": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "description": "Plain text; **bold** and *italic* markers are supported."
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "iconic": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "ancestry": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "art": {
      "type": "object",
      "properties": {
        "emblem": {
          "type": "string",
          "minLength": 1,
          "description": "Generic SVG emblem drawn for this project."
        },
        "paizo": {
          "type": "object",
          "properties": {
            "pack": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Stable identifier (lowercase, digits, hyphens)."
            },
            "file": {
              "type": "string",
              "description": "Path of the image inside the art pack."
            }
          },
          "required": [
            "pack",
            "file"
          ]
        },
        "local": {
          "description": "File name looked up in a locally supplied art folder.",
          "type": "string"
        }
      },
      "required": [
        "emblem"
      ]
    },
    "links": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "source",
    "group",
    "keyAttributes",
    "traditions",
    "casting",
    "hp",
    "ratings",
    "features",
    "art"
  ]
}
